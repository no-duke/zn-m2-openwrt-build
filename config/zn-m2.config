CONFIG_PACKAGE_openclash_INCLUDE_Haproxy=y
CONFIG_PACKAGE_openclash_INCLUDE_IPv6_NAT=n
CONFIG_PACKAGE_openclash_INCLUDE_Metacubexd=y
